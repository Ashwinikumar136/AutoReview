# Gemini API Key (Required for AI Review Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Render sets this automatically)
PORT=3000

# Admin Access Password (Required for /admin login)
ADMIN_PASSWORD=your_secure_password_here

# Cloud Database (Optional - Recommended for 100% data persistence across Render redeployments)
# MongoDB Atlas Free Tier (M0): mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=autoreview
